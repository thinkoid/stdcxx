}

/* status cells: a tint of the status's hue and the hue as text */

td.OK, td.XPASS, td.BASE, td.NOUT, td.OUTPUT, td.MISS,
td.WARN, td.XWARN, td.EXIT, td.XEXIT, td.FORMAT,
td.RUNWARN, td.XRUNWARN, td.DIFF, td.XDIFF, td.ASSERT,
td.XASSERT, td.SIGNAL, td.XSIGNAL, td.COMP, td.XCOMP,
td.LINK, td.XLINK, td.EXEC, td.xdep {
    --hue: var(--muted);
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 14%, var(--surface));
    font-family: var(--mono);
    font-weight: 600;
    text-align: center;
}

td a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 2px;
}

td.name a {
    color: var(--link);
    text-decoration: none;
}

td.name a:hover {
    text-decoration: underline;
}

/* success */
td.OK, td.BASE, td.NOUT, td.OUTPUT       { --hue: var(--ok); }

/* failures */
td.ASSERT, td.EXIT, td.DIFF              { --hue: var(--fail); }
td.FORMAT, td.WARN, td.RUNWARN           { --hue: var(--warn); }
td.COMP, td.LINK, td.EXEC                { --hue: var(--build); }

td.SIGNAL {
    color: #ffffff;
    background: var(--fail);
}

/* expected failures and unexpected successes */
td.XASSERT, td.XEXIT, td.XDIFF, td.XSIGNAL,
td.XCOMP, td.XLINK, td.XWARN, td.XRUNWARN {
    --hue: var(--muted);
    font-style: italic;
}

td.XPASS                                 { --hue: var(--note); }

/* not tested */
td.MISS, td.xdep {
    --hue: var(--muted);
    font-weight: 400;
}

/* a log whose library failed to build */
tr.LIB td {
    background: color-mix(in srgb, var(--fail) 10%, var(--surface));
}
EOF

