#!/bin/sh
########################################################################
#
# script to derive the pin of the names a shared library exports
#
########################################################################
#
# Licensed to the Apache Software  Foundation (ASF) under one or more
# contributor  license agreements.  See  the NOTICE  file distributed
# with  this  work  for  additional information  regarding  copyright
# ownership.   The ASF  licenses this  file to  you under  the Apache
# License, Version  2.0 (the  "License"); you may  not use  this file
# except in  compliance with the License.   You may obtain  a copy of
# the License at
#
# http://www.apache.org/licenses/LICENSE-2.0
#
# Unless required by applicable law or agreed to in writing, software
# distributed under the  License is distributed on an  "AS IS" BASIS,
# WITHOUT  WARRANTIES OR CONDITIONS  OF ANY  KIND, either  express or
# implied.   See  the License  for  the  specific language  governing
# permissions and limitations under the License.
#
########################################################################
#
# USAGE:
#
#     derive-exports <shared-library>
#
# DESCRIPTION:
#
#     Writes the names the shared library exports in the form of the
#     exports pins under doc/notes/baseline: the mangled names that
#     nm -D --defined-only lists, without a symbol version, one per
#     line, sorted bytewise. A name is written when one of the
#     library's own objects, the .o files in the directory of the
#     library, defines it as an external symbol. The names the
#     library takes from the archives it is linked with, those of
#     the compiler's language support library, are left out.
#
# EXAMPLE:
#
#     derive-exports build/lib/libstd15D.so > doc/notes/baseline/15D.exports
#
#     The command above pins the exported names of a 15D build. The
#     command below shows the names that joined or left since, with
#     c++filt to demangle them:
#
#     derive-exports build/lib/libstd15D.so |
#         diff doc/notes/baseline/15D.exports - | c++filt
#
########################################################################

##########
# global constants

# the name of the script (used in diagnostic messages)
readonly myname=${0##*/}


##########
# main body of script

if [ $# -ne 1 ]; then
    echo "$myname: usage: $myname <shared-library>" >&2
    exit 2
fi

lib=$1

# the objects the library is linked from are built beside it
set -- "${lib%/*}"/*.o
if [ "${lib%/*}" = "$lib" ]; then
    set -- ./*.o
fi

if [ ! -r "$1" ]; then
    echo "$myname: no objects beside $lib" >&2
    exit 1
fi

tmpdir=$(mktemp -d) || exit
trap 'rm -rf "$tmpdir"' 0

nm -P -g --defined-only "$@" > "$tmpdir/objects" || exit
nm -P -D --defined-only "$lib" > "$tmpdir/library" || exit

awk '
# the first file: the external names the objects define; the lines
# that name an object end in a colon and carry no type
FNR == NR {
    if (NF > 1)
        own [$1]
    next
}

# the second file: the exported names, the version dropped
{
    name = $1
    sub(/@.*/, "", name)

    if (name in own)
        print name
}' "$tmpdir/objects" "$tmpdir/library" | LC_ALL=C sort -u
