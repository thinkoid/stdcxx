#!/bin/sh
########################################################################
#
# script to build, test, and report a night of stdcxx configurations
#
########################################################################
#
# Licensed to the Apache Software  Foundation (ASF) under one or more
# contributor  license agreements.  See  the NOTICE  file distributed
# with  this  work  for  additional information  regarding  copyright
# ownership.   The ASF  licenses this  file to  you under  the Apache
# License, Version  2.0 (the  "License"); you may  not use  this file
# except in  compliance with the License.   You may obtain  a copy of
# the License at
#
# http://www.apache.org/licenses/LICENSE-2.0
#
# Unless required by applicable law or agreed to in writing, software
# distributed under the  License is distributed on an  "AS IS" BASIS,
# WITHOUT  WARRANTIES OR CONDITIONS  OF ANY  KIND, either  express or
# implied.   See  the License  for  the  specific language  governing
# permissions and limitations under the License.
#
########################################################################
#
# USAGE:
#
#     driver [ -c <configs> ]
#            [ -j <jobs> ]
#            [ -p <pin-dir> ]
#            [ -r <revision> ]
#            <night-dir>
#
# DESCRIPTION:
#
#     Exports the revision once per configuration into
#     <night-dir>/<config> and runs bin/buildntest there on the tests
#     alone, keeping the build directory. Then it writes the page of
#     each build to its build directory as index.html, and compares
#     the table of each run with its pin, both normalized by
#     bin/norm, their difference in <night-dir>/<config>.diff.
#
#     Each configuration logs to <night-dir>/<config>.log. The script
#     writes one line per step to stdout, then the verdict: the
#     number of tables identical to their pins. It exits non-zero
#     when a step fails or a table differs from its pin.
#
#     The scripts run from the tree the driver is in; the revision
#     tested is exported. The logs carry the environment, the host
#     name and the processors of the machine, and the pages are for
#     reading on it.
#
# OPTIONS:
#
#     -c <configs>
#         Specifies the list of configurations. Each is a build type
#         the GNUmakefile knows, with -clang appended for the build of
#         the same type under Clang. When omitted, defaults to
#         "11S 11s 15D".
#
#     -j <jobs>
#         Specifies the number of make jobs within a stage. When
#         omitted, defaults to the number of online processors.
#
#     -p <pin-dir>
#         Specifies the directory of the pins, named as under
#         doc/notes/baseline: <arch>-<config>.txt, where the arch is
#         the machine's, or i386 for a 32-bit build type on x86_64.
#         When omitted, defaults to doc/notes/baseline of the
#         exported revision.
#
#     -r <revision>
#         Specifies the git revision to test. When omitted, defaults
#         to HEAD of the tree the script is in.
#
# EXAMPLES:
#
#     driver -c "15D 15D-clang" ~/build/stdcxx-build/night-20261012
#
#     The command above tests HEAD in the 15D configuration under GCC
#     and under Clang, writes the page of each to
#     ~/build/stdcxx-build/night-20261012/<config>/build/index.html,
#     and compares each table with its pin under the revision's
#     doc/notes/baseline.
#
########################################################################

##########
# global constants

# the name of the script (used in diagnostic messages)
readonly myname=${0##*/}

# the top-level directory of the tree the script is in
readonly topdir=$(cd "$(dirname "$0")/.." && pwd)

# the compiler configuration file
readonly config=gcc.config

##########
# global variables

# by default (unless otherwise specified on the command line) test the
# GCC configurations of the certification
configs="11S 11s 15D"
jobs=$(getconf _NPROCESSORS_ONLN)
pindir=
revision=HEAD

# the exit status of the script, non-zero once a step fails
status=0


##########
# build_type(): writes the build type of the given configuration, the
# configuration's name without its -clang suffix
build_type()
{
    cfg=$1

    echo "${cfg%-clang}"
}


##########
# compiler(): writes the name and version of the compiler of the given
# configuration, as the log name wants them: gcc, or clang when the
# configuration ends in -clang
compiler()
{
    cfg=$1

    case $cfg in
        *-clang) echo "clang-$(clang -dumpversion)";;
        *)       echo "gcc-$(gcc -dumpfullversion)";;
    esac
}


##########
# log_name(): writes the name xcomp.awk expects of the gzipped log of
# the given configuration: os-version-arch-compiler-version-buildtype-1
log_name()
{
    cfg=$1

    os=$(uname -s | tr A-Z a-z)
    osver=$(uname -r | sed 's/^\([0-9]*\.[0-9]*\).*/\1/')
    arch=$(uname -m)

    echo "$os-$osver-$arch-$(compiler "$cfg")-$(build_type "$cfg")-1-log.gz.txt"
}


##########
# pin_name(): writes the name of the pin of the given configuration:
# the machine's architecture, i386 for a 32-bit build type on x86_64,
# then the configuration
pin_name()
{
    cfg=$1

    arch=$(uname -m)

    # a lowercase letter in the build type is a 32-bit build
    case $(build_type "$cfg") in
        *[a-z]) [ "$arch" = x86_64 ] && arch=i386;;
    esac

    echo "$arch-$cfg.txt"
}


##########
# run_build(): exports the revision into the configuration's directory
# and runs buildntest there on the tests alone, keeping the build
# directory; reports the exit status of buildntest
run_build()
{
    cfg=$1
    srcdir=$night/$cfg

    mkdir "$srcdir" || return
    git -C "$topdir" archive "$rev" | tar -x -C "$srcdir" || return

    # the export holds no revision; the log names it first
    echo "### revision:" > "$night/$cfg.log"
    echo "$rev" >> "$night/$cfg.log"

    # a Clang configuration names its compiler on the make line
    case $cfg in
        *-clang) make="make -j$jobs CXX=clang";;
        *)       make="make -j$jobs";;
    esac

    # buildntest is a bash script: it needs PIPESTATUS
    (cd "$srcdir" && MAKE="$make" bash "$topdir/bin/buildntest" \
        -k -e '' -l '' -C$config -B"$(build_type "$cfg")") \
        >> "$night/$cfg.log" 2>&1
}


##########
# render_page(): writes the page of a build to its build directory as
# index.html; reports the exit status of xbuildgen
render_page()
{
    cfg=$1
    builddir=$night/$cfg/build
    logname=$(log_name "$cfg")

    mkdir -p "$builddir/logs" || return
    gzip -c "$night/$cfg.log" > "$builddir/logs/$logname" || return

    # xcomp.awk runs bin/duration from the PATH
    PATH=$topdir/bin:$PATH bash "$topdir/bin/xbuildgen" -s \
        -T "stdcxx $rev, $cfg" -o "$builddir/index.html" \
        "$builddir/logs/$logname"
}


##########
# compare_table(): compares the table of a build's run with its pin,
# both normalized, and leaves their difference in <night>/<cfg>.diff;
# writes one line saying which, and reports non-zero unless the two
# are identical
compare_table()
{
    cfg=$1
    runlog=$night/$cfg/build/runall.log
    pin=${pindir:-$night/$cfg/doc/notes/baseline}/$(pin_name "$cfg")

    if [ ! -r "$runlog" ]; then
        echo "### table of $cfg: no run log $runlog"
        return 1
    fi

    if [ ! -r "$pin" ]; then
        echo "### table of $cfg: no pin $pin"
        return 1
    fi

    "$topdir/bin/norm" "$pin" > "$night/$cfg.pin" || return
    "$topdir/bin/norm" "$runlog" > "$night/$cfg.table" || return

    if diff "$night/$cfg.pin" "$night/$cfg.table" > "$night/$cfg.diff"; then
        echo "### table of $cfg: identical to ${pin##*/}"
    else
        lines=$(grep -c '^[<>]' "$night/$cfg.diff")
        echo "### table of $cfg: differs from ${pin##*/}," \
             "$lines lines, $night/$cfg.diff"
        return 1
    fi
}


##########
# report(): writes the outcome of a step and records a failure in the
# script's exit status
report()
{
    step=$1
    stepstatus=$2

    if [ "$stepstatus" -eq 0 ]; then
        echo "### $step: ok"
    else
        echo "### $step: failed with status $stepstatus"
        status=1
    fi
}


##########
# main body of script

# process command line options
while getopts ":c:j:p:r:" opt_name; do
    case $opt_name in
        c)  # argument is the list of configurations
            configs=$OPTARG
            ;;

        j)  # argument is the number of make jobs within a stage
            jobs=$OPTARG
            ;;

        p)  # argument is the directory of the pins
            pindir=$(cd "$OPTARG" && pwd) || exit 2
            ;;

        r)  # argument is the git revision to test
            revision=$OPTARG
            ;;

        :)  # OPTARG is the option missing its argument
            echo "$myname: option -$OPTARG requires an argument" >&2
            exit 2
            ;;

        *)  # OPTARG is the unknown option
            echo "$myname: unknown option : -$OPTARG" >&2
            exit 2
            ;;
    esac
done

# remove command line options and their arguments from the command line
shift $((OPTIND - 1))

if [ $# -ne 1 ]; then
    echo "$myname: usage: $myname [ -c <configs> ] [ -j <jobs> ]" \
         "[ -p <pin-dir> ] [ -r <revision> ] <night-dir>" >&2
    exit 2
fi

# resolve the revision once, so that every configuration tests one tree
rev=$(git -C "$topdir" rev-parse --short=8 "$revision^{commit}") || exit 2

# the night's directory is new, so that nothing in it is stale
mkdir "$1" || exit 2
night=$(cd "$1" && pwd)

echo "### $myname: $rev, $configs, -j$jobs, in $night"


# build and test the configurations, one at a time
for cfg in $configs; do
    run_build "$cfg"
    report "build and test $cfg" $?
done


# write the page of each configuration
for cfg in $configs; do
    render_page "$cfg" > "$night/$cfg.page.log" 2>&1
    report "page of $cfg: $night/$cfg/build/index.html" $?
done


# compare the table of each configuration with its pin
identical=0
total=0

for cfg in $configs; do
    total=$((total + 1))

    if compare_table "$cfg"; then
        identical=$((identical + 1))
    else
        status=1
    fi
done

echo "### verdict: $identical of $total tables identical to their pins"

exit $status
