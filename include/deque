namespace std {

template <class _TypeT, class _Allocator = allocator<_TypeT> >
class deque;


template <class _TypeT, class _DiffT, class _Pointer,
          class _Reference, class _Allocator>
class __rw_deque_iter
    : public iterator<random_access_iterator_tag, _TypeT, _DiffT,
                      _Pointer, _Reference>
{
public:
    typedef _Allocator                               allocator_type;
    typedef typename allocator_type::size_type       size_type;
    typedef _TypeT                                   value_type;
    typedef _DiffT                                   difference_type;
    typedef _Pointer                                 pointer;
    typedef _Reference                               reference;
    typedef random_access_iterator_tag               iterator_category;

    typedef typename allocator_type::template rebind<value_type*>::other
            _C_node_alloc_type;
    typedef typename _C_node_alloc_type::pointer        _C_node_pointer;

    static size_type _C_bufsize () {
        typedef deque<_TypeT, _Allocator> _RWDeque;
        return _RWSTD_NEW_CAPACITY (_RWDeque, (const _RWDeque*)0, 0);
    }

    __rw_deque_iter (): _C_node (0), _C_cur (0) { }

    __rw_deque_iter (_C_node_pointer __node, difference_type __off)
        : _C_node (__node), _C_cur (__node ? *__node : pointer ()) {
        if (_C_cur)
            _C_cur += __off;
        else
            _RWSTD_ASSERT (0 == __off);
    }

    __rw_deque_iter (const __rw_deque_iter &__rhs)
        : _C_node (__rhs._C_node), _C_cur (__rhs._C_cur) { }

    template <class _TypeU>
    __rw_deque_iter (const __rw_deque_iter<_TypeU, difference_type,
                                          value_type*, value_type&,
                                          allocator_type> &__rhs)
        : _C_node (__rhs._C_node), _C_cur (__rhs._C_cur) { }

    __rw_deque_iter& operator= (const __rw_deque_iter &__rhs) {
        _C_node = __rhs._C_node;
        _C_cur  = __rhs._C_cur;
        return *this;
    }

    __rw_deque_iter& operator++ () {
        if (++_C_cur == *_C_node + _C_bufsize ())
            _C_cur = *++_C_node;
        return *this;
    }

    __rw_deque_iter& operator-- () {
        if (!_C_cur || _C_cur == *_C_node)
            _C_cur = *--_C_node + _C_bufsize ();
        --_C_cur;

        return *this;
    }

    __rw_deque_iter operator++ (int) {
        __rw_deque_iter __tmp (*this);
        return ++*this, __tmp;
    }

    __rw_deque_iter operator-- (int) {
        __rw_deque_iter __tmp (*this);
        return --*this, __tmp;
    }

    __rw_deque_iter& operator+= (difference_type __n) {
        if (0 == __n)
            return *this;

        const difference_type __size = difference_type (_C_bufsize ());

        difference_type       __jump = __n / __size;
        const difference_type __rest = __n % __size;

        difference_type __off = _C_offset ();

        // Split the displacement before adding it to the offset, so a
        // representable displacement cannot overflow that addition.
        if (__rest < 0 && __off < -__rest) {
            --__jump;
            __off = __size - (-__rest - __off);
        }
        else if (0 <= __rest && __size - __rest <= __off) {
            ++__jump;
            __off -= __size - __rest;
        }
        else
            __off += __rest;

        _C_node += __jump;
        _C_cur = *_C_node;

        if (_C_cur)
            _C_cur += __off;
        else
            _RWSTD_ASSERT (0 == __off);

        return *this;
    }

    __rw_deque_iter& operator-= (difference_type __n) {
        return *this += -__n;
    }

    __rw_deque_iter operator+ (difference_type __n) const {
        return __rw_deque_iter (*this) += __n;
    }

    __rw_deque_iter operator- (difference_type __n) const {
        return __rw_deque_iter (*this) -= __n;
    }

    difference_type _C_offset () const {
        return _C_cur ? _C_cur - *_C_node : 0;
    }

    pointer _C_address () const { return _C_cur; }

    reference operator* () const { return *_C_address (); }

    pointer operator-> () const { return &**this; };

    reference operator[] (difference_type __n) const {
        return *(*this + __n);
    }

    // A boundary uses the following node and its buffer start, or null
    // if that node owns no buffer. The map's terminal null slot makes
    // stepping off its last buffer ordinary. No null pointer arithmetic.
    _C_node_pointer _C_node;
    pointer         _C_cur;
};


// for symmetry
template <class _TypeT, class _DiffT, class _Ptr, class _Ref, class _Alloc>
inline __rw_deque_iter<_TypeT, _DiffT, _Ptr, _Ref, _Alloc>
operator+ (typename __rw_deque_iter<_TypeT, _DiffT, _Ptr, _Ref,
                                     _Alloc>::difference_type __lhs,
           const __rw_deque_iter<_TypeT, _DiffT, _Ptr, _Ref, _Alloc> &__rhs)
{
    return __rhs + __lhs;
}


#define _RWSTD_DEQUE_ITER(n) \
        __rw_deque_iter<_TypeT, _DiffT, _Ptr##n, _Ref##n, _Alloc>


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline _DiffT
operator- (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    const _DiffT __nodes = __x._C_node == __y._C_node
        ? 0 : __x._C_node - __y._C_node;
    return __nodes * _DiffT (__x._C_bufsize ())
         + __x._C_offset () - __y._C_offset ();
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator== (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return __x._C_node == __y._C_node && __x._C_cur == __y._C_cur;
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator< (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return __x._C_node == __y._C_node
        ? __x._C_cur < __y._C_cur
        : __x._C_node < __y._C_node;
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator!= (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return !(__x == __y);
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator<= (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return !(__y < __x);
}

template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator>= (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return !(__x < __y);
}

template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator> (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return __y < __x;
}


#undef _RWSTD_DEQUE_ITER


template <class _TypeT, class _Allocator>
class deque: private _Allocator
{
public:

    typedef _TypeT                                    value_type;
    typedef _Allocator                                allocator_type;
    typedef typename allocator_type::size_type        size_type;
    typedef typename allocator_type::difference_type difference_type;
    typedef typename allocator_type::pointer          pointer;
    typedef typename allocator_type::const_pointer    const_pointer;
    typedef typename allocator_type::reference        reference;
    typedef typename allocator_type::const_reference const_reference;

    typedef allocator_type                           _C_value_alloc_type;

    // following two typedefs are used for convenience with debug iters
    typedef __rw_deque_iter<value_type, difference_type, pointer,
                            reference, allocator_type>         _C_deque_iter; 

    typedef __rw_deque_iter<value_type, difference_type, const_pointer,
                            const_reference, allocator_type>   _C_deque_citer;

    typedef typename allocator_type::template rebind<value_type*>::other
            _C_node_alloc_type;

    typedef typename _C_node_alloc_type::pointer        _C_node_pointer;

#ifndef _RWSTD_NO_DEBUG_ITER

    typedef __rw::__rw_debug_iter<deque, _C_deque_iter, _C_deque_iter>
        iterator;
    
    typedef __rw::__rw_debug_iter<deque, _C_deque_citer, _C_deque_iter>
        const_iterator;
    
    iterator _C_make_iter (const _C_deque_iter &__iter) { 
        return iterator (*this, __iter);
    }

    const_iterator _C_make_iter (const _C_deque_citer &__citer) const {
        return const_iterator (*this, __citer);
    }

#else   // if defined (_RWSTD_NO_DEBUG_ITER)
    
    typedef _C_deque_iter  iterator;
    typedef _C_deque_citer const_iterator;
    
    iterator _C_make_iter (const _C_deque_iter &__iter) {
        return __iter;
    }

    const_iterator _C_make_iter (const _C_deque_citer &__citer) const {
        return __citer;
    }

#endif   // _RWSTD_NO_DEBUG_ITER

    static size_type _C_bufsize () {
        return _C_deque_iter::_C_bufsize ();
    }

    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    typedef std::reverse_iterator<iterator>        reverse_iterator;

    explicit
    deque (const allocator_type &__alloc = allocator_type ())
      : allocator_type (__alloc) {
        _C_init ();
    }

    explicit
    deque (size_type __n, const_reference __x = value_type (), 
           const allocator_type &__alloc = allocator_type ())
        : allocator_type (__alloc) {
        _C_init ();
        _TRY {
            assign (__n, __x);
        }
        _CATCH (...) {
            // the destructor of an object whose constructor throws
            // does not run: destroy what assign built and free the storage
            clear ();
            _C_dealloc ();
            _RETHROW;
        }
    }

    template <class _Iterator>
    deque (_Iterator __first, _Iterator __last,
           const allocator_type &__alloc = allocator_type ())
        : allocator_type (__alloc) {
        _C_init ();
        _TRY {
            assign (__first, __last);
        }
        _CATCH (...) {
            clear ();
            _C_dealloc ();
            _RETHROW;
        }
    }

    deque (const deque &__rhs)
        : allocator_type (__rhs.get_allocator ()) {
        _C_init ();
        _TRY {
            assign (__rhs.begin (), __rhs.end ());
        }
        _CATCH (...) {
            clear ();
            _C_dealloc ();
            _RETHROW;
        }
    }

    ~deque () {
        clear ();
        _C_dealloc ();
    }

    deque& operator= (const deque&);

    template <class _Iterator>
    void assign (_Iterator __first, _Iterator __last) {
        // dispatch either to a range assign or to an assign with repetition
        _C_assign (__first, __last, _RWSTD_DISPATCH (_Iterator));
    }

    void assign (size_type __n, const_reference __x) {
        _C_assign_n (__n, __x);
    }

    allocator_type get_allocator () const {
        return *this;
    }

    iterator begin () {
        return _C_make_iter (_C_beg);
    }

    const_iterator begin () const {
        return _C_make_iter (_C_beg);
    }

    iterator end () {
        return _C_make_iter (_C_end);
    }

    const_iterator end () const {
        return _C_make_iter (_C_end);
    }

    reverse_iterator rbegin () {
        return reverse_iterator (end ());
    }

    const_reverse_iterator rbegin () const { 
        return const_reverse_iterator (end ());
    }
    
    reverse_iterator rend () { 
        return reverse_iterator (begin ());
    }

    const_reverse_iterator rend () const { 
        return const_reverse_iterator (begin ());
    }

    bool empty () const {
        return _C_beg == _C_end;
    }

    size_type size () const {
        return size_type (_C_end - _C_beg);
    }

    size_type max_size () const {
        const size_type __bufsize = _C_bufsize ();
        const size_type __values =
            allocator_type::max_size ();

        if (__values < __bufsize)
            return 0;

        const size_type __nodes = _C_max_nodes ();

        if (0 == __nodes)
            return 0;

        // the live range may start at the last slot of its first buffer
        const size_type __limit = (__nodes - 1) * __bufsize + 1;

        return __values < __limit ? __values : __limit;
    }

    void resize (size_type, value_type = value_type ());

    reference operator[] (size_type __inx) {
#ifdef _RWSTD_BOUNDS_CHECKING
        return at (__inx);
#else
        _RWSTD_ASSERT (_C_is_valid (0 /* valid and non-empty */));
        return *(begin () + __inx);
#endif
    }

    const_reference operator[] (size_type __inx) const {
#ifdef _RWSTD_BOUNDS_CHECKING
        return at (__inx);
#else
        _RWSTD_ASSERT (_C_is_valid (0 /* valid and non-empty */));
        return *(begin () + __inx);
#endif
    }

    const_reference at (size_type __inx) const { 
        return const_cast< deque* >(this)->at (__inx);
    }

    reference at (size_type __inx) {
        _RWSTD_REQUIRES (__inx < size (),
                         (_RWSTD_ERROR_OUT_OF_RANGE,
                          _RWSTD_FUNC ("deque::at(size_type)"),
                          __inx, size ()));
        return *(begin () + __inx);
    }

    reference front () {
        _RWSTD_ASSERT (_C_is_valid (0 /* valid and non-empty */));
        return *begin ();
    }

    const_reference front () const {
        _RWSTD_ASSERT (_C_is_valid (0 /* valid and non-empty */));
        return *begin ();
    }

    reference back () {
        _RWSTD_ASSERT (_C_is_valid (0 /* valid and non-empty */));
        return *(end () - 1);
    }

    const_reference back () const {
        _RWSTD_ASSERT (_C_is_valid (0 /* valid and non-empty */));
        return *(end () - 1);
    }

    void push_front (const_reference);

    void push_back (const_reference);

    iterator insert (iterator, const_reference);

    void insert (iterator __it, size_type __n, const_reference __x) {
        _C_insert_n (__it, __n, __x);
    }

    template <class _Iterator>
    void insert (iterator __it, _Iterator __first, _Iterator __last) {
        _C_insert (__it, __first, __last, _RWSTD_DISPATCH (_Iterator));
    }

    void pop_front ();

    void pop_back ();

    iterator erase (iterator);

    iterator erase (iterator, iterator);

    void swap (deque&);

    void clear () {
        erase (begin (), end ());

        _RWSTD_ASSERT (_C_is_valid (1 /* valid and empty */));
    }

private:

    // The non-null map slots form one contiguous owned span. The live
    // range lies within it; all other owned buffers are retained spares.
    // Ownership bounds are found by scanning, not stored in the deque.
    // The extra terminal map slot is null. See doc/notes/analysis-deque-redesign.md
    // for the representation and rollback invariants.
    _C_deque_iter   _C_beg;
    _C_deque_iter   _C_end;
    _C_node_pointer _C_nodes;
    size_type       _C_node_size;

    void _C_init () {
        _C_beg = _C_end = _C_deque_iter ();
        _C_nodes = 0;
        _C_node_size = 0;
    }

    size_type _C_max_nodes () const {
        const size_type __limit =
            size_type ((numeric_limits<difference_type>::max) ()) / _C_bufsize ();

        const size_type __slots = _C_node_alloc_type (*this).max_size ();
        const size_type __nodes = __slots ? __slots - 1 : 0;

        return __nodes < __limit ? __nodes : __limit;
    }

    // A reservation owns rollback until commit. Its scan results and
    // construction cursor belong to this operation, not the container.
    struct _C_reservation {
        deque&          _C_deque;

        // the storage as it was, restored on failure
        _C_deque_iter   _C_beg;
        _C_deque_iter   _C_end;
        _C_node_pointer _C_nodes;
        size_type       _C_node_size;

        // the owned span the scan found: first slot, count, and the
        // slot it was moved to if recentred
        size_type       _C_first;
        size_type       _C_count;
        size_type       _C_pos;

        // what the preparation changed and must undo: spare pointers
        // transferred, buffers allocated, and the first slot they fill
        size_type       _C_moved;
        size_type       _C_added;
        size_type       _C_alloc;

        // the request: how many elements, at which end, committed yet
        size_type       _C_n;
        bool            _C_back;
        bool            _C_done;

        // the reserved room and how far construction got into it
        _C_deque_iter   _C_base;
        _C_deque_iter   _C_cur;

        _C_reservation (deque&, bool, size_type);
        ~_C_reservation ();

        void _C_prepare ();
        void _C_restore ();
        void _C_commit ();

        void _C_construct (const_reference __x) {
            _C_deque.allocator_type::construct (_C_cur._C_address (), __x);
            ++_C_cur;
        }

    private:
        _C_reservation (const _C_reservation&);
        void operator= (const _C_reservation&);
    };

    void _C_move_nodes (size_type, size_type, size_type);
    void _C_push (bool, const_reference);
    void _C_dealloc ();
    void _C_insert_fill (size_type, size_type, const_reference);

    // implements assign with repetition
    void _C_assign_n (size_type, const_reference);

    // implements insert with repetition
    void _C_insert_n (const iterator&, size_type, const_reference);

    // the direct range insert, for sources whose operations cannot throw
    template <class _Iterator>
    void _C_insert_range (iterator, _Iterator, _Iterator,
                          bidirectional_iterator_tag);

    // the staged range insert, for any other source
    template <class _Iterator>
    void _C_insert_range (iterator, _Iterator, _Iterator,
                          input_iterator_tag);

    // implements range assign
    template <class _Iterator>
    void _C_assign (_Iterator __first, _Iterator __last, void*) {
        _RWSTD_ASSERT_RANGE (__first, __last);

        _C_assign_range (__first, __last, input_iterator_tag ());
    }

    // implements assign with repetition if value_type == size_type
    template <class _IntType>
    void _C_assign (_IntType __n, _IntType __x, int) {
        // see 23.1.1, p9 and DR 438
        _C_assign_n (__n, __x);
    }

    // implements range assign, one element at a time, for any iterator
    template <class _Iterator>
    void _C_assign_range (_Iterator, _Iterator, input_iterator_tag);

    // implements range insert
    template <class _Iterator>
    void _C_insert (const iterator &__it,
                   _Iterator __first, _Iterator __last, void*) {
        _RWSTD_ASSERT_RANGE (begin (), __it);
        _RWSTD_ASSERT_RANGE (__first, __last);

        _C_insert_range (__it, __first, __last, input_iterator_tag ());
    }

    void _C_insert (const iterator &__it, pointer __first,
                    pointer __last, void*) {
        _C_insert_range (__it, __first, __last,
                         bidirectional_iterator_tag ());
    }

    void _C_insert (const iterator &__it, const_pointer __first,
                    const_pointer __last, void*) {
        _C_insert_range (__it, __first, __last,
                         bidirectional_iterator_tag ());
    }

    void _C_insert (const iterator &__it, iterator __first,
                    iterator __last, void*) {
        _C_insert_range (__it, _ITER_BASE (__first), _ITER_BASE (__last),
                         bidirectional_iterator_tag ());
    }

    void _C_insert (const iterator &__it, const_iterator __first,
                    const_iterator __last, void*) {
        _C_insert_range (__it, _ITER_BASE (__first), _ITER_BASE (__last),
                         bidirectional_iterator_tag ());
    }

    // implements insert with repetition if value_type == size_type
    template <class _IntType>
    void _C_insert (const iterator &__it,
                    _IntType __n, _IntType __x, int) {
        // see 23.1.1, p9 and DR 438
        _C_insert_n (__it, __n, __x);
    }


    bool _C_is_valid (int = -1) const;
};


template <class _TypeT, class _Allocator>
inline void
deque<_TypeT, _Allocator>::push_front (const_reference __x)
{
    _RWSTD_ASSERT (_C_is_valid ());

    _RWSTD_REQUIRES (size () < max_size (),
                     (_RWSTD_ERROR_LENGTH_ERROR,
                      _RWSTD_FUNC ("deque::push_front(const_reference)"),
                      size () + 1, max_size ()));

    // room before the first element of its buffer, or a reservation
    if (0 == _C_beg._C_offset ())
        _C_push (false, __x);
    else {
        allocator_type::construct (_C_beg._C_address () - 1, __x);
        --_C_beg;
    }

    _RWSTD_ASSERT (_C_is_valid (0));
}


template <class _TypeT, class _Allocator>
inline void
deque<_TypeT, _Allocator>::push_back (const_reference __x)
{
    _RWSTD_ASSERT (_C_is_valid ());

    _RWSTD_REQUIRES (size () < max_size (),
                     (_RWSTD_ERROR_LENGTH_ERROR,
                      _RWSTD_FUNC ("deque::push_back(const_reference)"),
                      size () + 1, max_size ()));

    // a null element pointer means the end slot owns no buffer yet
    if (0 == _C_end._C_cur)
        _C_push (true, __x);
    else {
        allocator_type::construct (_C_end._C_address (), __x);
        ++_C_end;
    }

    _RWSTD_ASSERT (_C_is_valid (0));
}


template <class _TypeT, class _Allocator>
inline void
deque<_TypeT, _Allocator>::pop_front ()
{
    _RWSTD_ASSERT (_C_is_valid (0));
    allocator_type::destroy (_C_beg._C_address ());
    ++_C_beg;
    _RWSTD_ASSERT (_C_is_valid ());
}


template <class _TypeT, class _Allocator>
inline void
deque<_TypeT, _Allocator>::pop_back ()
{
    _RWSTD_ASSERT (_C_is_valid (0));
    --_C_end;
    allocator_type::destroy (_C_end._C_address ());
    _RWSTD_ASSERT (_C_is_valid ());
}


template <class _TypeT, class _Allocator>
inline void
deque<_TypeT, _Allocator>::
resize (size_type __new_size, value_type __x /* = value_type () */)
{
    _RWSTD_ASSERT (_C_is_valid ());

    const size_type __size = size ();

    if (__size < __new_size)
        insert (end (), __new_size - __size, __x);
    else if (__new_size < __size)
        erase (begin () + __new_size, end ());
}


template <class _TypeT, class _Allocator>
inline bool
operator== (const deque<_TypeT, _Allocator> &__lhs,
            const deque<_TypeT, _Allocator> &__rhs)
{
    return    __lhs.size () == __rhs.size ()
           && std::equal (__lhs.begin (), __lhs.end (), __rhs.begin ());
}


template <class _TypeT, class _Allocator>
inline bool
operator< (const deque<_TypeT, _Allocator> &__lhs,
           const deque<_TypeT, _Allocator> &__rhs)
{
    return std::lexicographical_compare (__lhs.begin (), __lhs.end (),
                                          __rhs.begin (), __rhs.end ());
}


template <class _TypeT, class _Allocator>
inline bool
operator!= (const deque<_TypeT, _Allocator> &__lhs,
            const deque<_TypeT, _Allocator> &__rhs)
{
    return !(__lhs == __rhs);
}


template <class _TypeT, class _Allocator>
inline bool
operator<= (const deque<_TypeT, _Allocator> &__lhs,
            const deque<_TypeT, _Allocator> &__rhs)
{
    return !(__rhs < __lhs);
}


template <class _TypeT, class _Allocator>
inline bool
operator> (const deque<_TypeT, _Allocator> &__lhs,
           const deque<_TypeT, _Allocator> &__rhs)
{
    return __rhs < __lhs;
}


template <class _TypeT, class _Allocator>
inline bool
operator>= (const deque<_TypeT, _Allocator> &__lhs,
            const deque<_TypeT, _Allocator> &__rhs)
{
