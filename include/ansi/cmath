#ifdef _RWSTD_NO_POW_FLT_INT
inline float pow (float __x, int __y)
{
    float __res = __y % 2 ? __x : 1;

    for (int __i = __y < 0 ? -__y : __y; __i >>= 1; ) {
        __x *= __x;
        if (__i % 2)
            __res *= __x;
    }

    return __y < 0 ? __res ? 1 / __res : -1 / __res : __y ? __res : 1;
}
#endif   // _RWSTD_NO_POW_FLT_INT


